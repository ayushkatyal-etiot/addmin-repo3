# The live AddMin App URL that every "Start Free Trial" / "Book a Demo"
# CTA deep-links into. Points at a placeholder in dev; set to the real
# deployed app URL before this site goes live.
PUBLIC_APP_URL=https://app.addmin.example

# Optional: a form-handling endpoint (e.g. Formspree, Basin) for the
# Contact page. Left unset, the contact form shows a direct mailto fallback
# instead of silently failing -- see src/pages/contact.astro.
PUBLIC_CONTACT_FORM_ENDPOINT=
