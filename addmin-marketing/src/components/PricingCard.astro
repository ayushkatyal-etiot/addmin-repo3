---
import type { Plan } from "../content/pricing";

interface Props {
  plan: Plan;
}

const { plan } = Astro.props;
---

<div class:list={["pricing-card", { highlighted: plan.highlighted }]}>
  {plan.highlighted && <span class="badge" style="align-self: flex-start; margin-bottom: 0.75rem;">Most popular</span>}
  <h3>{plan.name}</h3>
  <p class="muted">{plan.officeRange}</p>
  <div>
    <span class="price">{plan.price}</span>
    {plan.priceSuffix && <span class="price-suffix">{plan.priceSuffix}</span>}
  </div>
  <p class="muted" style="margin-top: 0.75rem;">{plan.description}</p>
  <ul>
    {plan.features.map((feature) => <li>{feature}</li>)}
  </ul>
  <a href={plan.ctaHref} class:list={["btn", plan.highlighted ? "btn-primary" : "btn-ghost"]}>
    {plan.ctaLabel}
  </a>
</div>
