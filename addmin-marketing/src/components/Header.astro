---
const APP_URL = import.meta.env.PUBLIC_APP_URL ?? "https://app.addmin.example";
---

<header class="site-header">
  <div class="container">
    <a href="/" class="brand">
      <img src="/addmin-logo.png" alt="AddMin" height="56" />
    </a>
    <nav class="main-nav" aria-label="Main">
      <a href="/how-it-works">How it works</a>
      <a href="/pricing">Pricing</a>
      <a href="/who-its-for">Who it's for</a>
      <a href="/about">About</a>
      <a href="/blog">Blog</a>
      <a href="/contact">Contact</a>
    </nav>
    <div class="header-actions">
      <a href="/contact" class="btn-link">Book a Demo</a>
      <a href={`${APP_URL}/signup`} class="btn btn-primary">Start Free Trial</a>
    </div>
  </div>
</header>
