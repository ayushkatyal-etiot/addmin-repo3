---
// Native <details>/<summary> -- an accordion with zero JavaScript, in
// keeping with Step 10's "near-zero JS" tech decision.
interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;
---

<div>
  {
    items.map((item) => (
      <details class="faq-item">
        <summary>{item.question}</summary>
        <p>{item.answer}</p>
      </details>
    ))
  }
</div>
