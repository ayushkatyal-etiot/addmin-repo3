# Copy to .env.server and fill in real values. Never commit .env.server.

DATABASE_URL=
PORT=

# Must match the client's actual dev port -- used to build links in emails
# (verification, password reset, invites).
WASP_WEB_CLIENT_URL=

SENDGRID_API_KEY=

# Build Step 03: signs the Platform Operator session cookie
# (src/server/platform/platformAuth.ts). Falls back to DATABASE_URL in dev if
# unset -- set a real value in staging/prod.
PLATFORM_SESSION_SECRET=

STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=

AWS_S3_BUCKET=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=

# Build Step 11: error tracking (src/server/monitoring/sentry.ts). Unset ->
# Sentry stays uninitialized, no-op.
SENTRY_DSN=
