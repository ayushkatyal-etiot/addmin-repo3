datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================================
// Build Step 02 (planmysaas-blueprint/08-build-playbook.md): data layer.
// Transcribed field-for-field from planmysaas-blueprint/04-architecture.md's
// data model. `org_id` is on every model except Organization and PlatformOperator,
// per 04-architecture.md's note that it "reserves an org_id on every table" so
// the deferred multi-org Group-tenancy layer never needs a destructive migration.
//
// Four FK targets referenced by 04-architecture.md's "-> has many / -> belongs to"
// annotations are NOT modeled here because 04-architecture.md never gives them
// field-level definitions (only names them as another module's owned entity):
//   - UtilityBill.invoice_doc_id / ComplianceItem.document_id -> Document
//     (Document Module, 04-architecture.md - not yet specified)
//   - Asset "-> has many AssetAssignment" (Asset Module - introduced in Step 08)
//   - User "-> has many RoleAssignment / ApprovalAction" (Identity & Access /
//     Workflow & Approval modules - introduced in Steps 03 and 07)
// These are kept as plain nullable scalar columns, not Prisma relations, so this
// step transcribes 04-architecture.md rather than inventing schema it doesn't
// specify. Revisit when the owning module's build step defines them for real.
//
// User.org_id / User.role / User.email are nullable for now even though
// 04-architecture.md marks them non-nullable: nothing populates them until
// Step 03 wires org creation into the signup flow. Tighten to NOT NULL once
// Step 03 lands.
// =============================================================================

// --- Identity & Access Module --------------------------------------------

model User {
  id String @id @default(uuid())

  org_id      String?
  email       String?   @unique
  role        UserRole?
  office_scope Json?
  mfa_enabled Boolean  @default(false)
  // TOTP secret (base32), set once during MFA enrollment (src/server/auth/mfa.ts).
  // Never returned to the client after enrollment completes.
  mfa_secret  String?
  // Set by verifyMfaCode succeeding; authz.ts requires this to be in the
  // future for any mfa_enabled user, on every request -- see mfa.ts.
  mfa_verified_until DateTime?
  // Not in 04-architecture.md's original data model -- added in Build Step
  // 07 because F-11 requires a Payment Authorizer's recorded payment to be
  // blocked server-side once it exceeds their configured limit. Null = no
  // limit configured (org admin sets one via /admin/workflow's approver setup).
  authorization_limit Decimal?

  organization Organization? @relation(fields: [org_id], references: [id])

  officeSetupProfilesActivated OfficeSetupProfile[]     @relation("OfficeSetupProfileActivatedBy")
  checklistItemsOwned          OfficeChecklistItem[]    @relation("ChecklistItemOwner")
  obligationSchedulesOwned     RecurringObligationSchedule[] @relation("ObligationScheduleOwner")
  paymentsAuthorized           Payment[]                @relation("PaymentAuthorizedBy")
  auditLogs                    AuditLog[]               @relation("AuditLogActor")
  invitesSent                  Invite[]                 @relation("InviteInvitedBy")
  obligationInstancesWaived    ObligationInstance[]     @relation("ObligationInstanceWaivedBy")
  utilityBillsCreated          UtilityBill[]            @relation("UtilityBillCreatedBy")
  workflowDefinitionsAssigned  WorkflowDefinition[]     @relation("WorkflowApprover")
  approvalStepsAssigned        ApprovalStep[]           @relation("ApprovalStepApprover")
  vendorPerformanceReviewsGiven VendorPerformanceReview[] @relation("VendorPerformanceReviewedBy")

  @@index([org_id])
}

enum UserRole {
  platform_admin
  office_admin
  checker
  payment_authorizer
  vendor_manager
  compliance_coordinator
  facility_staff
  office_head
  employee
}

// Deliberately not a row in User, and carries no org_id -- an AddMin staff
// identity, authenticated on a separate /platform login, never a Membership
// of any customer Organization. See 04-architecture.md.
model PlatformOperator {
  id                 String    @id @default(uuid())
  email              String    @unique
  password_hash      String
  mfa_enabled        Boolean   @default(false)
  mfa_secret         String?
  mfa_verified_until DateTime?
  created_at         DateTime  @default(now())

  auditLogs AuditLog[]
}

// Not in 04-architecture.md's original data model -- added in Build Step 03
// because the user chose an invite-only teammate flow: only the first user
// of an Organization signs up self-serve (creating the org, per F-19); every
// other User is created by accepting one of these. See userSignupFields.ts.
model Invite {
  id           String       @id @default(uuid())
  org_id       String
  email        String
  role         UserRole
  office_scope Json?
  token        String       @unique
  status       InviteStatus @default(pending)
  invited_by   String
  created_at   DateTime     @default(now())
  expires_at   DateTime

  organization Organization @relation(fields: [org_id], references: [id])
  invitedBy    User         @relation("InviteInvitedBy", fields: [invited_by], references: [id])

  @@index([org_id])
}

enum InviteStatus {
  pending
  accepted
  expired
  revoked
}

// --- Organization & Office Module ----------------------------------------

model Organization {
  id               String                     @id @default(uuid())
  name             String
  gstin            String?
  default_currency String
  timezone         String
  tenant_status    OrganizationTenantStatus   @default(active)
  created_at       DateTime                   @default(now())
  // F-13: org-wide default TDS rate on rent, overridable per Landlord
  // (Landlord.tds_rate_pct). Null until Finance/CA configures it -- see
  // src/server/property/rentPayment.ts's block-if-unconfigured rule.
  default_tds_rate_pct Decimal?

  subscription Subscription?
  offices      Office[]
  vendors      Vendor[]
  users        User[]
  landlords    Landlord[]
}

enum OrganizationTenantStatus {
  active
  suspended
}

model Subscription {
  id                                String             @id @default(uuid())
  org_id                            String             @unique
  plan                              SubscriptionPlan
  status                            SubscriptionStatus
  trial_ends_at                     DateTime?
  billing_provider_customer_id      String?
  billing_provider_subscription_id  String?
  activated_at                      DateTime?

  organization Organization @relation(fields: [org_id], references: [id])

  @@index([org_id])
}

enum SubscriptionPlan {
  starter
  growth
  enterprise
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  expired
  canceled
}

model Office {
  id             String            @id @default(uuid())
  org_id         String
  // Not in 04-architecture.md's original data model -- added in Build Step
  // 04 because F-03's acceptance criteria requires "Office code is unique
  // within an organization" (used for CSV bulk import row dedup). See
  // migrations/*_step04_onboarding for the backfill of pre-existing rows.
  code           String
  name           String
  address        String
  office_type    OfficeType
  ownership_type OwnershipType
  setup_status   OfficeSetupStatus
  created_at     DateTime          @default(now())

  organization Organization @relation(fields: [org_id], references: [id])

  setupProfile     OfficeSetupProfile?
  checklistItems   OfficeChecklistItem[]
  utilityAccounts  UtilityAccount[]
  leases           Lease[]
  assets           Asset[]
  maintenanceRequests MaintenanceRequest[]
  complianceItems  ComplianceItem[]
  workflowDefinitions WorkflowDefinition[]

  @@index([org_id])
  @@unique([org_id, code])
}

enum OfficeType {
  head_office
  regional
  branch
  warehouse
  other
}

enum OwnershipType {
  owned
  rented
}

enum OfficeSetupStatus {
  draft
  setup_incomplete
  active
  inactive
}

// --- Onboarding Module -----------------------------------------------------

model OfficeSetupProfile {
  id             String    @id @default(uuid())
  org_id         String
  office_id      String    @unique
  completion_pct Decimal
  activated_at   DateTime?
  activated_by   String?

  office       Office @relation(fields: [office_id], references: [id])
  activatedBy  User?  @relation("OfficeSetupProfileActivatedBy", fields: [activated_by], references: [id])

  checklistItems OfficeChecklistItem[]

  @@index([org_id])
}

model OfficeChecklistItem {
  id                  String                  @id @default(uuid())
  org_id              String
  office_id           String
  office_setup_profile_id String?
  template_item_code  String
  category            ChecklistCategory
  applicability       ChecklistApplicability
  status              ChecklistItemStatus
  owner_user_id       String?
  linked_entity_type  String?
  linked_entity_id    String?

  office              Office              @relation(fields: [office_id], references: [id])
  officeSetupProfile  OfficeSetupProfile? @relation(fields: [office_setup_profile_id], references: [id])
  owner               User?               @relation("ChecklistItemOwner", fields: [owner_user_id], references: [id])

  @@index([org_id])
}

enum ChecklistCategory {
  utility
  facility
  compliance
  vendor
  asset
  role
}

enum ChecklistApplicability {
  yes
  no
  not_applicable
}

enum ChecklistItemStatus {
  pending
  configured
  complete
}

// --- Utility Module ----------------------------------------------------

model UtilityAccount {
  id               String               @id @default(uuid())
  org_id           String
  office_id        String
  utility_type     UtilityType
  provider_name    String
  meter_account_no String
  billing_cycle    BillingCycle
  vendor_id        String?
  status           UtilityAccountStatus

  office Office  @relation(fields: [office_id], references: [id])
  vendor Vendor? @relation(fields: [vendor_id], references: [id])

  bills     UtilityBill[]

  @@index([org_id])
}

enum UtilityType {
  electricity
  water
  internet
  telephone
  gas
  dg
  ups
  solar
  other
}

enum BillingCycle {
  monthly
  bimonthly
  quarterly
}

enum UtilityAccountStatus {
  active
  inactive
}

// --- Obligation Engine ---------------------------------------------------

// scope_ref_id is a polymorphic id, not a typed Prisma FK: depending on
// scope_type it points into UtilityAccount (utility), Lease (rent/cam),
// AMCContract (amc), or ComplianceItem (compliance). org_id is stored directly
// here (rather than relying on a hop through one of those four tables) because
// a polymorphic reference isn't a real FK Prisma can traverse.
model RecurringObligationSchedule {
  id                    String             @id @default(uuid())
  org_id                String
  scope_type            ObligationScopeType
  scope_ref_id           String
  frequency             ObligationFrequency
  expected_window_days  Int
  due_rule              String
  owner_user_id         String
  active_from           DateTime           @db.Date
  active_to             DateTime?          @db.Date

  owner User @relation("ObligationScheduleOwner", fields: [owner_user_id], references: [id])

  instances ObligationInstance[]

  @@index([org_id])
  @@index([scope_type, scope_ref_id])
}

enum ObligationScopeType {
  utility
  rent
  cam
  amc
  compliance
}

enum ObligationFrequency {
  monthly
  bimonthly
  quarterly
  annual
}

model ObligationInstance {
  id                String                 @id @default(uuid())
  org_id            String
  schedule_id       String
  period            String
  expected_date     DateTime               @db.Date
  due_date          DateTime?              @db.Date
  status            ObligationInstanceStatus
  linked_ref_type   String?
  linked_ref_id     String?
  // Not in 04-architecture.md's original data model -- added in Build Step
  // 06 because F-08's acceptance criteria requires "Waiving a Missing item
  // requires a remark and is recorded in AuditLog" (the AuditLog entry alone
  // doesn't let the UI show "waived by X, because Y" without a second query).
  waived_by         String?
  waived_remark     String?
  waived_at         DateTime?

  schedule RecurringObligationSchedule @relation(fields: [schedule_id], references: [id])
  waivedBy User?                       @relation("ObligationInstanceWaivedBy", fields: [waived_by], references: [id])

  bill UtilityBill?

  @@unique([schedule_id, period])
  @@index([org_id])
}

enum ObligationInstanceStatus {
  expected
  received
  missing
  in_process
  closed
  cancelled
  waived
}

model UtilityBill {
  id                      String            @id @default(uuid())
  org_id                  String
  utility_account_id      String
  obligation_instance_id  String?           @unique
  billing_period          String
  amount                  Decimal
  due_date                DateTime          @db.Date
  status                  UtilityBillStatus
  // References Document (Document Module, 04-architecture.md) -- not yet
  // modeled, see file header. Plain id, not a Prisma relation, for now.
  invoice_doc_id          String?
  // Not in 04-architecture.md's original data model -- added in Build Step
  // 07 because F-10's maker-checker rule ("the same user cannot be both
  // Maker and Checker on the same bill") needs to know who the Maker was.
  created_by              String?

  utilityAccount     UtilityAccount      @relation(fields: [utility_account_id], references: [id])
  obligationInstance ObligationInstance? @relation(fields: [obligation_instance_id], references: [id])
  createdBy          User?               @relation("UtilityBillCreatedBy", fields: [created_by], references: [id])

  payments      Payment[]
  approvalSteps ApprovalStep[]

  @@index([org_id])
}

enum UtilityBillStatus {
  draft
  pending_approval
  approved
  rejected
  partially_paid
  paid
  overdue
}

// --- Workflow & Approval Module ------------------------------------------
// Owns WorkflowDefinition/ApprovalStep/ApprovalAction per 04-architecture.md's
// module list, but (like Document and AssetAssignment elsewhere in this file)
// 04-architecture.md never gives these field-level definitions -- designed
// here in Build Step 07 against F-10/F-11's acceptance rubric instead.
// ApprovalAction is folded into ApprovalStep (status/remark/acted_at on the
// same row) rather than a separate table -- one step is acted on at most
// once, so a separate action-log table would just mirror this one.

// One threshold tier for an office+scope combination: bills up to max_amount
// (null = uncapped, the catch-all top tier) route to approver_user_id.
// office_id null = org-wide default, used when no office-specific tier
// matches. scope_type reuses ObligationScopeType since the same engine
// generalizes to Lease/AMC/Compliance approvals in Step 08.
model WorkflowDefinition {
  id                String              @id @default(uuid())
  org_id            String
  office_id         String?
  scope_type        ObligationScopeType
  tier              Int
  max_amount        Decimal?
  approver_user_id  String

  office   Office? @relation(fields: [office_id], references: [id])
  approver User    @relation("WorkflowApprover", fields: [approver_user_id], references: [id])

  @@index([org_id])
  @@unique([org_id, office_id, scope_type, tier])
}

// payable_type/payable_id is the same polymorphic pattern as Payment above --
// not a typed FK, so Step 08's Lease/AMC/Compliance approvals can reuse this
// table without payable_id being constrained to one entity. utility_bill_id
// is the convenience typed FK for today's only payable_type.
// approver_user_id is snapshotted from the WorkflowDefinition tier active at
// submission time, so a later threshold change never moves an in-flight
// bill's approver (F-10 edge case).
model ApprovalStep {
  id                String             @id @default(uuid())
  org_id            String
  payable_type      PayableType
  payable_id        String
  tier              Int
  approver_user_id  String
  status            ApprovalStepStatus
  remark            String?
  acted_at          DateTime?
  created_at        DateTime           @default(now())

  approver User @relation("ApprovalStepApprover", fields: [approver_user_id], references: [id])

  utility_bill_id String?
  utilityBill     UtilityBill? @relation(fields: [utility_bill_id], references: [id])

  @@index([org_id])
  @@index([payable_type, payable_id])
}

enum ApprovalStepStatus {
  pending
  approved
  rejected
  returned
}

// --- Property & Lease Module ---------------------------------------------

model Lease {
  id               String      @id @default(uuid())
  org_id           String
  office_id        String
  landlord_id      String
  start_date       DateTime    @db.Date
  end_date         DateTime    @db.Date
  // Day-of-month anchor for rent/CAM obligation periods (Step 06 engine),
  // same role as UtilityAccount's billing start date -- may differ from
  // start_date when rent is due on a fixed day each month.
  rent_due_anchor_date DateTime @db.Date
  rent_amount      Decimal
  cam_amount       Decimal?
  security_deposit Decimal?
  security_deposit_refunded Boolean @default(false)
  escalation_pct   Decimal?
  // Date the escalation_pct increase takes effect. Set alongside
  // escalation_pct at lease creation/renewal; leaseEscalationJob applies the
  // increase to rent_amount exactly once on/after this date (escalation_applied_at
  // is the idempotency guard -- see src/server/property/leaseJobs.ts).
  escalation_effective_date DateTime? @db.Date
  escalation_applied_at     DateTime?
  status           LeaseStatus

  office   Office   @relation(fields: [office_id], references: [id])
  landlord Landlord @relation(fields: [landlord_id], references: [id])

  payments Payment[]

  @@index([org_id])
}

enum LeaseStatus {
  draft
  active
  expiring
  renewed
  terminated
}

model Landlord {
  id           String @id @default(uuid())
  org_id       String
  name         String
  pan          String?
  bank_details Json
  // F-13: TDS is opt-in per landlord; tds_rate_pct overrides
  // Organization.default_tds_rate_pct when set. A TDS-applicable landlord
  // with neither configured blocks rent payment (see rentPayment.ts).
  tds_applicable Boolean @default(false)
  tds_rate_pct   Decimal?

  organization Organization @relation(fields: [org_id], references: [id])

  leases Lease[]

  @@index([org_id])
}

// --- Vendor Module ---------------------------------------------------------

model Vendor {
  id         String        @id @default(uuid())
  org_id     String
  name       String
  category   VendorCategory
  pan_gstin  String?
  status     VendorStatus

  organization Organization @relation(fields: [org_id], references: [id])

  amcContracts       AMCContract[]
  utilityAccounts    UtilityAccount[]
  workOrders         WorkOrder[]
  performanceReviews VendorPerformanceReview[]

  @@index([org_id])
}

enum VendorCategory {
  utility_provider
  dg
  ups
  solar
  amc
  building_mgmt
  other
}

enum VendorStatus {
  pending_activation
  active
  suspended
  inactive
}

model AMCContract {
  id                 String            @id @default(uuid())
  org_id             String
  vendor_id          String
  linked_entity_type String
  linked_entity_id   String
  start_date         DateTime          @db.Date
  end_date           DateTime          @db.Date
  status             AMCContractStatus

  vendor Vendor @relation(fields: [vendor_id], references: [id])

  @@index([org_id])
}

enum AMCContractStatus {
  active
  due_for_renewal
  expired
  closed
}

// F-14: "Vendor performance record captures SLA compliance rate, response
// time, and quality rating" -- one row per review, so a vendor's history is
// a trend, not a single overwritten score.
model VendorPerformanceReview {
  id                  String   @id @default(uuid())
  org_id              String
  vendor_id           String
  sla_compliance_pct  Decimal
  response_time_hours Decimal
  quality_rating      Int
  remark              String?
  reviewed_by         String
  created_at          DateTime @default(now())

  vendor     Vendor @relation(fields: [vendor_id], references: [id])
  reviewedBy User   @relation("VendorPerformanceReviewedBy", fields: [reviewed_by], references: [id])

  @@index([org_id])
}

// --- Facility & Maintenance Module -----------------------------------------

model MaintenanceRequest {
  id         String                  @id @default(uuid())
  org_id     String
  office_id  String
  category   String
  priority   MaintenancePriority
  status     MaintenanceRequestStatus

  office Office @relation(fields: [office_id], references: [id])

  workOrder WorkOrder?

  @@index([org_id])
}

enum MaintenancePriority {
  low
  medium
  high
  critical
}

enum MaintenanceRequestStatus {
  open
  assigned
  in_progress
  resolved
  closed
}

model WorkOrder {
  id                       String          @id @default(uuid())
  org_id                   String
  maintenance_request_id   String          @unique
  vendor_id                String?
  sla_due_at               DateTime
  status                   WorkOrderStatus

  maintenanceRequest MaintenanceRequest @relation(fields: [maintenance_request_id], references: [id])
  vendor             Vendor?            @relation(fields: [vendor_id], references: [id])

  @@index([org_id])
}

enum WorkOrderStatus {
  assigned
  in_progress
  completed
  verified
}

// --- Asset Module ------------------------------------------------------

model Asset {
  id            String      @id @default(uuid())
  org_id        String
  office_id     String
  category      String
  serial_no     String?
  status        AssetStatus
  warranty_end  DateTime?   @db.Date

  office Office @relation(fields: [office_id], references: [id])

  // "-> has many AssetAssignment" in 04-architecture.md is not modeled yet --
  // see file header. AssetAssignment/AssetRequest are introduced in Step 08.

  @@index([org_id])
}

enum AssetStatus {
  available
  assigned
  under_service
  retired
}

// --- Compliance Module -----------------------------------------------------

model ComplianceItem {
  id               String               @id @default(uuid())
  org_id           String
  office_id        String
  compliance_type  String
  status           ComplianceItemStatus
  expiry_date      DateTime?            @db.Date
  // References Document (Document Module, 04-architecture.md) -- not yet
  // modeled, see file header. Plain id, not a Prisma relation, for now.
  document_id      String?

  office Office @relation(fields: [office_id], references: [id])

  @@index([org_id])
}

enum ComplianceItemStatus {
  missing
  valid
  expiring
  expired
  not_applicable
}

// --- Payment Module ----------------------------------------------------

// payable_type/payable_id is a polymorphic reference (utility_bill/rent/cam/
// vendor), not a typed Prisma FK -- org_id is stored directly for the same
// reason as RecurringObligationSchedule above.
model Payment {
  id             String        @id @default(uuid())
  org_id         String
  payable_type   PayableType
  payable_id     String
  // Rent/CAM payments only (utility_bill already carries its own period via
  // UtilityBill.billing_period) -- the "2026-09" style key a rent/cam
  // payment covers, so TDS/payment history can be filtered and deduped
  // period-wise per F-13 (see src/server/property/rentPayment.ts).
  period         String?
  // Rent/CAM: the installment due date the payment covers (like UtilityBill.due_date).
  due_date       DateTime?      @db.Date
  amount         Decimal
  tds_amount     Decimal?
  net_amount     Decimal
  mode           String
  status         PaymentStatus
  authorized_by  String?

  authorizedBy User? @relation("PaymentAuthorizedBy", fields: [authorized_by], references: [id])

  // Convenience FKs so UtilityBill/Lease payments are also real relations,
  // in addition to the generic payable_type/payable_id pair above.
  utility_bill_id String?
  utilityBill     UtilityBill? @relation(fields: [utility_bill_id], references: [id])
  lease_id        String?
  lease           Lease?       @relation(fields: [lease_id], references: [id])

  @@index([org_id])
}

enum PayableType {
  utility_bill
  rent
  cam
  vendor
}

enum PaymentStatus {
  pending
  approved
  initiated
  paid
  failed
  partially_paid
  overdue
}

// --- Audit Module ------------------------------------------------------

model AuditLog {
  id             String   @id @default(uuid())
  org_id         String
  // Exactly one of these two is set. actor_user_id is nullable (was
  // required in Step 02/03) because Build Step 05 needs to audit Platform
  // Operator actions (F-20) -- PlatformOperator is deliberately not a row
  // in User (04-architecture.md), so it gets its own nullable FK rather than
  // forcing a fake User row into existence just to satisfy the old NOT NULL.
  actor_user_id  String?
  actor_platform_operator_id String?
  entity_type    String
  entity_id      String
  action         String
  before_value   Json?
  after_value    Json?
  created_at     DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actor_user_id], references: [id])
  actorPlatformOperator PlatformOperator? @relation(fields: [actor_platform_operator_id], references: [id])

  @@index([org_id])
}

// --- Notification Module ----------------------------------------------

// Not in 04-architecture.md's original data model -- added in Build Step 05
// because F-19's acceptance rubric explicitly requires reminder jobs to be
// "verified by ... checking NotificationLog", but 04-architecture.md's
// compact data model never field-specifies the Notification Module's owned
// entities (same gap category as Invite in Step 03 -- see schema.prisma's
// top-of-file note).
model NotificationLog {
  id               String   @id @default(uuid())
  org_id           String
  notification_type String  // e.g. "trial_reminder_3d", "trial_reminder_1d", "trial_expired"
  recipient_user_id String?
  recipient_email  String
  sent_at          DateTime @default(now())
  metadata         Json?

  @@index([org_id])
}

// Build Step 08: per-org, per-domain reminder-window config, per
// 08-build-playbook.md's mandatory pattern ("renewal reminder windows are
// config values, not hardcoded per-job constants"). One row per
// org+rule_type; reminder_days is a JSON int array, e.g. [180, 90, 60, 30].
// Falls back to DEFAULT_REMINDER_DAYS in leaseJobs.ts when no row exists, so
// an org needs no setup step before reminders start working.
model NotificationRule {
  id            String               @id @default(uuid())
  org_id        String
  rule_type     NotificationRuleType
  reminder_days Json

  @@unique([org_id, rule_type])
  @@index([org_id])
}

enum NotificationRuleType {
  lease_renewal
  amc_renewal
  compliance_expiry
}
